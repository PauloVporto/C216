# Valores apenas para desenvolvimento local. Troque a senha antes de expor o banco.
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca
API_PORT=8000
FRONTEND_PORT=5173
DB_PORT=5432
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Usada ao executar a API fora do Docker:
DATABASE_URL=postgresql+asyncpg://biblioteca:biblioteca@localhost:5432/biblioteca
